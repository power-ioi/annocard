{
  "name": "obsidian-annocard",
  "version": "3.3.3",
  "description": "AnnoCard - 独立标注数据 + 卡片化管理：高亮、批注、标签、批量删除、复习模式",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
