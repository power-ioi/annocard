    "highlight",
    "markdown",
    "marker"
  ],
  "license": "MIT",
  "author": "uuq007",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "esbuild": "0.25.5",
    "tslib": "2.4.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "diff": "^8.0.3",
    "obsidian": "^1.13.1"
  }
